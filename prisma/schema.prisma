datasource db {
  provider = "sqlite"
  url      = env("DATABASE_FILE")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                              String   @id            @default(uuid())

  discordId                       String   @unique
  discordAccessToken              String
  discordRefreshToken             String
  tokenExpiresAt                  DateTime
  
  nintendoUserId                  String?
  pendingFriendRequestApproval    Boolean  @default(true)
  
  isPresenceActive                Boolean  @default(true)
  showHoursPlayed                 Boolean  @default(true)
}